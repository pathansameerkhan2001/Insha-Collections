# ==============================================================================
# INSHA COLLECTIONS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
#
# IMPORTANT SECURITY RULES:
# - These variables must remain strictly server-side.
# - NEVER prefix these with NEXT_PUBLIC_* or expose them to browser JavaScript.
# - Copy this file to .env.local for local testing, or configure in your deployment hosting.
# - NEVER commit actual AWS secret access keys or credentials into the git repository.
# ==============================================================================

# 1. Meta WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=your_permanent_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_API_VERSION=v21.0
BUSINESS_WHATSAPP_NUMBER=919618648050
SITE_URL=https://insha-collections.com
WHATSAPP_MESSAGING_MODE=auto
WHATSAPP_TEMPLATE_NAME=order_notification
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_SIMULATION_MODE=false

# ==============================================================================
# AWS S3 - SECURE SERVER-SIDE PRODUCT IMAGE STORAGE
# ==============================================================================
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET_NAME=insha-collection-assets
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Optional: CloudFront CDN distribution domain for fast worldwide asset delivery
# AWS_CLOUDFRONT_DOMAIN=https://d123456789.cloudfront.net

# ==============================================================================
# AWS COGNITO - ADMIN USER AUTHENTICATION
# ==============================================================================
AWS_COGNITO_REGION=ap-southeast-2
AWS_COGNITO_USER_POOL_ID=ap-southeast-2_BAyDRrryV
AWS_COGNITO_CLIENT_ID=1o4lmii74fafsmui9rnpu6em2v
AWS_COGNITO_CLIENT_SECRET=your_cognito_app_client_secret_here
